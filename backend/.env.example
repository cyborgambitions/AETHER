# AETHER - Environment Variables for local + Render
# Copy this file to .env and fill values. Never commit real secrets.

# === Required for AI calls ===
# Users can also bring their own key via the UI (recommended for most)
# Must start with xai- from https://console.x.ai (not a Stripe/OpenAI sk_ key)
XAI_API_KEY=xai-your-key-here

# === Monetization (Stripe) ===
STRIPE_SECRET_KEY=sk_test_...
STRIPE_PUBLISHABLE_KEY=pk_test_...
# Create a product + price in Stripe and put the price ID here for Pro plan
STRIPE_PRO_PRICE_ID=price_...

# === Optional ===
DEFAULT_MODEL=grok-4.5
DATABASE_PATH=data/aether.db
CORS_ORIGINS=*
